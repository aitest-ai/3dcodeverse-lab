{
  "framework": null,
  "buildCommand": "python3 build_from_release.py",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/models/(.*)", "headers": [{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"}]}
  ]
}